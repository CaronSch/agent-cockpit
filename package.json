{
  "name": "agent-cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "In-browser workbench for AI coding harnesses: magnetic, split-tree modular windows (VS Code workbench grid model).",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p .",
    "claude-md": "node scripts/update-claude-md.js",
    "claude-md:check": "node scripts/update-claude-md.js --check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
